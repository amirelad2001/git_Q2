QWidget {
    color: #000000;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 10pt;
}

#centralWidget {
    background-color: #f4f7fb;
}

QLabel#mainTitle {
    color: #000000;
    font-size: 22pt;
    font-weight: 700;
}

QLabel#aboutTitle {
    color: #000000;
    font-size: 16pt;
    font-weight: 700;
}

QLabel#aboutDetails {
    line-height: 1.5;
}

QPushButton {
    color: #000000;
    background-color: #ffffff;
    border: 1px solid #d5deea;
    border-radius: 8px;
    padding: 9px 16px;
}

QPushButton:hover {
    background-color: #edf3fa;
    border-color: #9eb4d0;
}

QPushButton:pressed {
    background-color: #e2ebf6;
}

QPushButton#primaryButton {
    background-color: #e7edf5;
    border-color: #b8c5d6;
    color: #000000;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #dbe5f1;
    border-color: #9eafc5;
}

QPushButton#primaryButton:pressed {
    background-color: #cbd8e8;
}

QDialog {
    background-color: #ffffff;
}

QLabel a {
    color: #000000;
}

QToolBar {
    background-color: #f4f7fb;
    border: none;
    spacing: 6px;
}

QToolBar QLabel {
    color: #000000;
    background-color: transparent;
}

QToolBar QToolButton {
    color: #000000;
    background-color: #ffffff;
    border: 1px solid #d5deea;
    border-radius: 6px;
    padding: 5px;
}

QToolBar QToolButton:disabled {
    color: #000000;
    background-color: #ffffff;
}

QToolBar QToolButton:checked {
    background-color: #e7edf5;
    border-color: #000000;
}

QToolBar QToolButton:hover {
    background-color: #edf3fa;
}

QToolTip {
    color: #000000;
    background-color: #ffffff;
    border: 1px solid #d5deea;
}

FigureCanvasQTAgg {
    background-color: #ffffff;
}
